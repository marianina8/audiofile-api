<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<meta name="referrer" content="no-referrer">
<meta name="color-scheme" content="light dark">
<title>{{.Name}}</title>
<style>
:root {
  --bg: #f6f6f4; --card: #ffffff; --text: #1c1c1e; --muted: #6b6b70;
  --line: #e4e4e0; --accent: #2f6fed; --accent-text: #ffffff; --active: #e8effd;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #121214; --card: #1c1c1f; --text: #f2f2f4; --muted: #9a9aa2;
    --line: #2c2c31; --accent: #6b9bff; --accent-text: #0d1020; --active: #232a3d;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0; padding: 24px 16px 48px; background: var(--bg); color: var(--text);
  font: 16px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
main { max-width: 640px; margin: 0 auto; }
h1 { margin: 0 0 4px; font-size: 1.6rem; line-height: 1.2; overflow-wrap: anywhere; }
.count { margin: 0 0 20px; color: var(--muted); font-size: .9rem; }
.player { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 16px; margin-bottom: 20px; }
.now { margin: 0 0 12px; min-height: 1.4em; font-weight: 600; overflow-wrap: anywhere; }
audio { width: 100%; }
.controls { display: flex; gap: 8px; margin-top: 12px; }
button {
  flex: 1; padding: 12px; border: 1px solid var(--line); border-radius: 10px;
  background: transparent; color: var(--text); font: inherit; cursor: pointer;
}
button.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-text); }
button:disabled { opacity: .4; cursor: default; }
button:focus-visible, li:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
ol { list-style: none; margin: 0; padding: 0; background: var(--card); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
li { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-top: 1px solid var(--line); cursor: pointer; }
li:first-child { border-top: 0; }
li.current { background: var(--active); }
.num { width: 1.5rem; color: var(--muted); font-variant-numeric: tabular-nums; text-align: right; flex: none; }
li.current .num { color: var(--accent); font-weight: 700; }
.meta { flex: 1; min-width: 0; }
.title { display: block; font-weight: 500; overflow-wrap: anywhere; }
.artist { display: block; color: var(--muted); font-size: .875rem; overflow-wrap: anywhere; }
.status { display: block; color: var(--accent); font-size: .8rem; }
.status:empty { display: none; }
.status.err { color: #d64545; }
@media (prefers-color-scheme: dark) { .status.err { color: #ff8a8a; } }
.bpm { flex: none; color: var(--muted); font-size: .8rem; font-variant-numeric: tabular-nums; }
</style>
</head>
<body>
<main>
<h1>{{.Name}}</h1>
<p class="count">{{len .Tracks}} {{if eq (len .Tracks) 1}}track{{else}}tracks{{end}}</p>
<section class="player">
<p class="now" id="now" aria-live="polite"></p>
<audio controls id="audio" preload="auto"></audio>
<div class="controls">
<button type="button" id="prev">Previous</button>
<button type="button" id="next" class="primary">Next</button>
</div>
</section>
<ol id="list">
{{range $i, $t := .Tracks}}<li data-i="{{$i}}" tabindex="0"><span class="num">{{inc $i}}</span><span class="meta"><span class="title">{{$t.Title}}</span>{{if $t.Artist}}<span class="artist">{{$t.Artist}}</span>{{end}}<span class="status" aria-live="polite"></span></span>{{if $t.BPM}}<span class="bpm">{{$t.BPM}} BPM</span>{{end}}</li>
{{end}}</ol>
</main>
<script>
const tracks = {{.Tracks}};
let audio = document.getElementById("audio");
const now = document.getElementById("now");
const prev = document.getElementById("prev");
const next = document.getElementById("next");
const rows = Array.from(document.querySelectorAll("#list li"));
const statuses = rows.map(r => r.querySelector(".status"));
let cur = 0;
// Hidden element that buffers the next track; swapped in on advance.
let nextAudio = null;
let nextIdx = -1;

function setStatus(text, isErr) {
  statuses.forEach((s, n) => {
    s.textContent = n === cur ? text : "";
    s.classList.toggle("err", n === cur && !!isErr);
  });
}

function bind(el) {
  ["loadstart", "waiting"].forEach(ev => el.addEventListener(ev, () => { if (el === audio) setStatus("Loading\u2026"); }));
  ["playing", "canplay"].forEach(ev => el.addEventListener(ev, () => { if (el === audio) setStatus(""); }));
  el.addEventListener("error", () => { if (el === audio) setStatus("Couldn\u2019t load this track", true); });
  el.addEventListener("ended", () => { if (el === audio && cur < tracks.length - 1) load(cur + 1, true); });
}

function show(i) {
  cur = i;
  rows.forEach((r, n) => {
    r.classList.toggle("current", n === i);
    if (n === i) r.setAttribute("aria-current", "true"); else r.removeAttribute("aria-current");
  });
  now.textContent = tracks[i].title + (tracks[i].artist ? " \u2014 " + tracks[i].artist : "");
  prev.disabled = i === 0;
  next.disabled = i === tracks.length - 1;
  setStatus("");
}

// Stop an unused element from downloading and release its resources.
function dispose(el) {
  try { el.pause(); el.removeAttribute("src"); el.load(); } catch (e) {}
}

function prefetch(i) {
  if (nextAudio && nextIdx === i) return;
  if (nextAudio) { dispose(nextAudio); nextAudio = null; nextIdx = -1; }
  if (i >= tracks.length) return;
  nextAudio = new Audio();
  nextAudio.preload = "auto";
  nextAudio.src = tracks[i].url;
  nextIdx = i;
}

function load(i, play) {
  show(i);
  if (nextAudio && nextIdx === i) {
    // Swap the already-buffered element into the page in place of the old one.
    const el = nextAudio;
    nextAudio = null; nextIdx = -1;
    const old = audio;
    const hadFocus = document.activeElement === old;
    el.volume = old.volume;
    el.muted = old.muted;
    el.playbackRate = old.playbackRate;
    old.pause();
    el.controls = true;
    el.id = "audio";
    old.replaceWith(el);
    audio = el;
    bind(el);
    dispose(old);
    if (hadFocus) el.focus();
    if (el.error) setStatus("Couldn\u2019t load this track", true);
    else if (el.readyState < 3) setStatus("Loading\u2026");
  } else {
    audio.src = tracks[i].url;
  }
  if (play) {
    const el = audio;
    const pr = el.play();
    if (pr && pr.catch) pr.catch(err => {
      if (el === audio && err && err.name === "NotAllowedError") setStatus("Tap \u25B6 to continue");
    });
  }
  prefetch(i + 1);
}

rows.forEach((r, n) => {
  r.addEventListener("click", () => load(n, true));
  r.addEventListener("keydown", e => {
    if (e.key === "Enter" || e.key === " ") { e.preventDefault(); load(n, true); }
  });
});
prev.addEventListener("click", () => { if (cur > 0) load(cur - 1, !audio.paused); });
next.addEventListener("click", () => { if (cur < tracks.length - 1) load(cur + 1, !audio.paused); });

bind(audio);
load(0, false);
</script>
</body>
</html>
